{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harness-redesign/h9-mitosis-state.schema.json",
  "title": "H9 mitosis run state",
  "description": "The run directory's state.json that mitosis rewrites after every stage; lanes and msps are keyed by the decimal index of the plan's Lane or MSP.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "plan_id",
    "feature_branch",
    "base_commit",
    "started",
    "drift",
    "worktrees",
    "lanes",
    "msps",
    "stacking_exceptions",
    "merge_danger",
    "sandbox"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "feature_branch": {
      "type": "string",
      "minLength": 1
    },
    "base_commit": {
      "$ref": "#/$defs/commit"
    },
    "started": {
      "$ref": "#/$defs/timestamp"
    },
    "drift": {
      "$ref": "#/$defs/drift"
    },
    "worktrees": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/worktree"
      }
    },
    "lanes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/lane"
      }
    },
    "msps": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/msp"
      }
    },
    "stacking_exceptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stacking_exception"
      }
    },
    "merge_danger": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "door",
            "blast_radius"
          ],
          "properties": {
            "door": {
              "enum": [
                "one-way",
                "two-way"
              ]
            },
            "blast_radius": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "sandbox": {
      "enum": [
        "off",
        "sandbox-exec"
      ]
    },
    "gate_classes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gate_class"
      }
    },
    "gate_classes_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lock": {
      "anyOf": [
        {
          "$ref": "#/$defs/lock"
        },
        {
          "type": "null"
        }
      ]
    },
    "referee": {
      "$ref": "#/$defs/referee"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "gate_classes"
        ]
      },
      "then": {
        "required": [
          "gate_classes_sha256"
        ]
      }
    },
    {
      "if": {
        "required": [
          "gate_classes_sha256"
        ]
      },
      "then": {
        "required": [
          "gate_classes"
        ]
      }
    },
    {
      "if": {
        "required": [
          "lock"
        ]
      },
      "then": {
        "required": [
          "referee"
        ]
      }
    },
    {
      "if": {
        "required": [
          "referee"
        ]
      },
      "then": {
        "required": [
          "lock"
        ]
      }
    }
  ],
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\+00:00$"
    },
    "gate_outcome": {
      "enum": [
        "pass",
        "weak",
        "inert",
        "inconclusive",
        "not-applicable"
      ]
    },
    "msp_state": {
      "enum": [
        "shipped",
        "pushed",
        "unchanged",
        "committed",
        "ship-failed",
        "blocked",
        "referee-reverted",
        "gate-failed",
        "parked"
      ]
    },
    "lane_state": {
      "enum": [
        "ok",
        "failed",
        "blocked",
        "merge-blocked",
        "held",
        "parked-limit"
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass",
        "weak",
        "inert",
        "inconclusive",
        "not-applicable"
      ],
      "properties": {
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "weak": {
          "type": "integer",
          "minimum": 0
        },
        "inert": {
          "type": "integer",
          "minimum": 0
        },
        "inconclusive": {
          "type": "integer",
          "minimum": 0
        },
        "not-applicable": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "mutants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tried",
        "killed"
      ],
      "properties": {
        "tried": {
          "type": "integer",
          "minimum": 0
        },
        "killed": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "file",
                "line",
                "op"
              ],
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "op": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "mutation": {
      "enum": [
        "killed",
        "weak",
        "covered-elsewhere",
        "not-applicable"
      ]
    },
    "coverage": {
      "enum": [
        "traced",
        "untraced"
      ]
    },
    "killers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "property_rules": {
      "description": "What an acceptance property carries for its outcome: weak, inert and inconclusive name file, test and reason; pass names file and test; not-applicable may leave all three null.",
      "allOf": [
        {
          "if": {
            "required": [
              "outcome"
            ],
            "properties": {
              "outcome": {
                "enum": [
                  "weak",
                  "inert",
                  "inconclusive"
                ]
              }
            }
          },
          "then": {
            "required": [
              "file",
              "test",
              "reason"
            ],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "test": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "outcome"
            ],
            "properties": {
              "outcome": {
                "enum": [
                  "pass"
                ]
              }
            }
          },
          "then": {
            "required": [
              "file",
              "test"
            ],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "test": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "file",
        "test",
        "outcome",
        "reason",
        "seconds"
      ],
      "properties": {
        "step": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "test": {
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "$ref": "#/$defs/gate_outcome"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "seconds": {
          "type": "number",
          "minimum": 0
        },
        "check": {
          "type": "string"
        },
        "class": {
          "enum": [
            "not-applicable",
            "covered-elsewhere",
            "removed"
          ]
        },
        "with_work": {
          "type": "integer"
        },
        "reverted": {
          "type": [
            "integer",
            "null"
          ]
        },
        "mutants": {
          "$ref": "#/$defs/mutants"
        },
        "mutation": {
          "$ref": "#/$defs/mutation"
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "killers": {
          "$ref": "#/$defs/killers"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/property_rules"
        }
      ]
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "blocks",
        "properties",
        "implementation",
        "reverted",
        "counts",
        "commit",
        "referee"
      ],
      "properties": {
        "outcome": {
          "$ref": "#/$defs/gate_outcome"
        },
        "blocks": {
          "type": "boolean"
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/property"
          }
        },
        "implementation": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reverted": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "counts": {
          "$ref": "#/$defs/counts"
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "referee": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "crossing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "msp",
        "label"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "msp": {
          "type": "integer",
          "minimum": 0
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reconcile": {
      "description": "A full reconcile carries every key; a committed-only or blocked one carries referee and fatal, plus undeclared when unreplayed writes were found.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "referee",
        "fatal"
      ],
      "properties": {
        "changed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "declared": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "undeclared": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unwritten": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "untouched": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "crossing": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/crossing"
          }
        },
        "referee": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fatal": {
          "type": "boolean"
        }
      },
      "if": {
        "required": [
          "changed"
        ]
      },
      "then": {
        "required": [
          "declared",
          "undeclared",
          "unwritten",
          "untouched",
          "crossing"
        ]
      }
    },
    "ship": {
      "description": "pushed is the pushed commit or null; title and body exist only once pushed; pull_request is the pull-request command's last stdout line, or empty.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "base",
        "remote",
        "pushed",
        "pull_request",
        "stacking_exception",
        "unchanged"
      ],
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "base": {
          "type": "string",
          "minLength": 1
        },
        "remote": {
          "type": "string",
          "minLength": 1
        },
        "pushed": {
          "anyOf": [
            {
              "$ref": "#/$defs/commit"
            },
            {
              "type": "null"
            }
          ]
        },
        "pull_request": {
          "anyOf": [
            {
              "const": ""
            },
            {
              "type": "string",
              "pattern": "^https?://\\S+$"
            }
          ]
        },
        "stacking_exception": {
          "type": "boolean"
        },
        "unchanged": {
          "type": "boolean"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "required": [
          "pushed"
        ],
        "properties": {
          "pushed": {
            "type": "string"
          }
        }
      },
      "then": {
        "required": [
          "title",
          "body"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "title"
              ]
            },
            {
              "required": [
                "body"
              ]
            }
          ]
        }
      }
    },
    "replayed": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "bounded_return": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item",
        "status",
        "files_changed",
        "notes"
      ],
      "properties": {
        "item": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "files_changed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "seed_skip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "reason"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "foreign_write": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "owner",
        "suspects"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "integer",
          "minimum": 0
        },
        "suspects": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane",
        "msp",
        "state",
        "reason",
        "exit",
        "returned",
        "stdout",
        "stderr",
        "merged",
        "commit",
        "started",
        "finished",
        "session_id",
        "seeded",
        "seed_skipped",
        "seed_seconds"
      ],
      "properties": {
        "lane": {
          "type": "integer",
          "minimum": 0
        },
        "msp": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "$ref": "#/$defs/lane_state"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "exit": {
          "type": [
            "integer",
            "null"
          ]
        },
        "timed_out": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "returned": {
          "anyOf": [
            {
              "$ref": "#/$defs/bounded_return"
            },
            {
              "type": "null"
            }
          ]
        },
        "stdout": {
          "type": [
            "string",
            "null"
          ]
        },
        "stderr": {
          "type": [
            "string",
            "null"
          ]
        },
        "merged": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "commit": {
          "anyOf": [
            {
              "$ref": "#/$defs/commit"
            },
            {
              "type": "null"
            }
          ]
        },
        "started": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "finished": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "seeded": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "seed_skipped": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/seed_skip"
          }
        },
        "seed_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "clone": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "$ref": "#/$defs/commit"
        },
        "replayed": {
          "$ref": "#/$defs/replayed"
        },
        "unreplayed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ignored": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "foreign_writes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/foreign_write"
          }
        }
      }
    },
    "msp": {
      "description": "Written in stages, so an MSP mid-finish may hold only replayed or ignored; once state is set, reason is set beside it.",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "state": {
          "$ref": "#/$defs/msp_state"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "gate": {
          "anyOf": [
            {
              "$ref": "#/$defs/gate"
            },
            {
              "type": "null"
            }
          ]
        },
        "gate_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "gate_inputs": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reconcile": {
          "anyOf": [
            {
              "$ref": "#/$defs/reconcile"
            },
            {
              "type": "null"
            }
          ]
        },
        "ship": {
          "anyOf": [
            {
              "$ref": "#/$defs/ship"
            },
            {
              "type": "null"
            }
          ]
        },
        "blocked_by": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "replayed": {
          "$ref": "#/$defs/replayed"
        },
        "ignored": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "proven_head": {
          "$ref": "#/$defs/commit"
        },
        "trajectory_error": {
          "type": "string"
        },
        "lock": {
          "anyOf": [
            {
              "$ref": "#/$defs/lock"
            },
            {
              "type": "null"
            }
          ]
        },
        "referee": {
          "$ref": "#/$defs/referee"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        },
        {
          "if": {
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "enum": [
                  "shipped",
                  "pushed"
                ]
              }
            }
          },
          "then": {
            "required": [
              "ship"
            ],
            "properties": {
              "ship": {
                "required": [
                  "pushed"
                ],
                "properties": {
                  "pushed": {
                    "$ref": "#/$defs/commit"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "const": "shipped"
              }
            }
          },
          "then": {
            "properties": {
              "ship": {
                "required": [
                  "pull_request"
                ],
                "properties": {
                  "pull_request": {
                    "type": "string",
                    "pattern": "^https?://\\S+$"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "const": "unchanged"
              }
            }
          },
          "then": {
            "required": [
              "ship"
            ],
            "properties": {
              "ship": {
                "required": [
