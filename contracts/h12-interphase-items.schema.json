{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harness-redesign/h12-interphase-items.schema.json",
  "title": "H12 interphase items",
  "description": "The Steps render_record.py writes to docs/specs/<slug>.items.json for mitosis and pipeline: when the record has a locked list, one check-author Step first, named check-author, with msp check-author only when another Step carries an msp, or one per msp label named check-author-<msp> with that msp; rules that compare Steps with each other or with the spec, such as a check-author's name matching its msp, stay in check_items.py.",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/$defs/item"
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "kebab": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "number": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "relative_path": {
      "$ref": "h11-interphase-record.schema.json#/$defs/relative_path"
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "task",
        "files",
        "source",
        "acceptance",
        "spec_ref"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/kebab"
        },
        "task": {
          "$ref": "#/$defs/text"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/relative_path"
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "test"
            ],
            "properties": {
              "file": {
                "$ref": "#/$defs/text"
              },
              "test": {
                "$ref": "#/$defs/text"
              },
              "check": {
                "$ref": "k1-acceptance.schema.json#/properties/id"
              }
            }
          }
        },
        "after": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/kebab"
          }
        },
        "contract_group": {
          "$ref": "#/$defs/text"
        },
        "type": {
          "const": "contract"
        },
        "complexity": {
          "enum": [
            "simple",
            "complex"
          ]
        },
        "file_notes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "msp": {
          "$ref": "#/$defs/text"
        },
        "spec_ref": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/number"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "role": {
          "const": "check-author"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "contract_group"
            ]
          }
        },
        {
          "if": {
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "name": {
                "pattern": "^check-author(-[a-z0-9]+)*$"
              },
              "acceptance": {
                "maxItems": 0
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "after"
                  ]
                },
                {
                  "required": [
                    "type"
                  ]
                },
                {
                  "required": [
                    "contract_group"
                  ]
                },
                {
                  "required": [
                    "complexity"
                  ]
                },
                {
                  "required": [
                    "file_notes"
                  ]
                }
              ]
            }
          },
          "else": {
            "properties": {
              "name": {
                "not": {
                  "pattern": "^check-author(-|$)"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "role"
            ],
            "properties": {
              "name": {
                "const": "check-author"
              }
            }
          },
          "then": {
            "properties": {
              "msp": {
                "const": "check-author"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "role",
              "msp"
            ]
          },
          "then": {
            "properties": {
              "msp": {
                "$ref": "#/$defs/kebab"
              }
            }
          }
        }
      ]
    }
  }
}
