{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harness-redesign/h10b-decompose-return.schema.json",
  "title": "H10b decompose return",
  "description": "The last JSON-object line a decompose Worker prints, either a whole structure or a delta revising one; each Step's own fields are judged by core.validate, not here.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "assumptions",
        "constraints"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assumption"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keep",
        "change",
        "add",
        "remove",
        "assumptions",
        "constraints"
      ],
      "properties": {
        "keep": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "change": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "add": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "remove": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assumption"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "text"
      ],
      "properties": {
        "step": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
